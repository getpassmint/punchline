{
  "name": "tenthcup",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "wrangler d1 migrations apply tenthcup --local",
    "db:migrate:remote": "wrangler d1 migrations apply tenthcup --remote",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@passmint/node": "^0.2.2",
    "isbot": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vite-plugin": "^1.43.1",
    "@react-router/dev": "^7.18.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "wrangler": "^4.107.1"
  }
}
