{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passmint-punchline-demo",
  "workers_dev": true,
  // Needs the domain's zone in the same Cloudflare account. Forks: change or remove.
  "routes": [{ "pattern": "punchline.passmint.com", "custom_domain": true }],
  "preview_urls": false,
  "compatibility_date": "2026-07-08",
  // nodejs_compat: webhook signature checks (node:crypto).
  // global_fetch_strictly_public: this site shares a zone with api.passmint.com,
  // and same-zone fetches skip Worker routes unless they go out as public requests.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "passmint-punchline-demo",
      "database_id": "a7c7dda3-d5aa-4278-91df-624d9ba0f6a1",
      "migrations_dir": "migrations"
    }
  ],
  // /scan issues a real pass per request, so it's capped per IP.
  "ratelimits": [
    {
      "name": "SCAN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  // Daily cleanup of idle cards (workers/app.ts).
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "vars": {
    // Canonical address for share cards. Optional: defaults to the request's origin.
    "PUBLIC_URL": "https://punchline.passmint.com",
    // Swap the strip art on each punch (needs `pnpm setup:pass`; falls back without it).
    "PASSMINT_STRIP_VARIANTS": "on",
    "PASSMINT_TEMPLATE_ID": "tmpl_kfterihycqvs6fvylkcgly5r"
  }
}
