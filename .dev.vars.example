# Copy to .dev.vars for local development. In production these are
# Worker secrets: `wrangler secret put PASSMINT_API_KEY`.

# Your Passmint API key. A pmk_test_ key issues working passes marked [TEST].
PASSMINT_API_KEY=

# The loyalty template to issue against (tmpl_...).
PASSMINT_TEMPLATE_ID=

# Optional: the webhook signing secret, which turns on wallet status
# ("in your wallet", "delivered") in the UI.
# PASSMINT_WEBHOOK_SECRET=
